---
// Structured Data (Schema.org JSON-LD) for SEO
// Targets: Event schema for circle meetings, LocalBusiness for geo-targeting

interface Props {
  type?: 'homepage' | 'event';
}

const { type = 'homepage' } = Astro.props;
import logoImage from '../assets/images/image03.jpg';

const siteUrl = Astro.site ?? new URL('https://putovnykruh.cz');
const logoUrl = new URL(logoImage.src, siteUrl).toString();

// Organization Schema - appears on all pages
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Putovní mužský kruh',
  description: 'Bezpečný prostor pro muže na Blanensku a v Brně. Sdílení u ohně, autentické rozhovory, mužská podpora.',
  url: 'https://putovnykruh.cz',
  logo: logoUrl,
  areaServed: [
    {
      '@type': 'City',
      name: 'Blansko',
      '@id': 'https://www.wikidata.org/wiki/Q540666'
    },
    {
      '@type': 'City', 
      name: 'Brno',
      '@id': 'https://www.wikidata.org/wiki/Q14960'
    },
    {
      '@type': 'AdministrativeArea',
      name: 'Blanensko',
      containedIn: {
        '@type': 'Country',
        name: 'Česká republika'
      }
    }
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+420777347591',
    contactType: 'customer support',
    availableLanguage: ['Czech']
  },
  founder: [
    {
      '@type': 'Person',
      name: 'Jožo'
    },
    {
      '@type': 'Person',
      name: 'Martin'
    }
  ],
  sameAs: [
    'https://chat.whatsapp.com/JVL1HKS5Jj0K8hsY5YBsL4'
  ]
};

// LocalBusiness Schema - for geo-targeting Blansko/Brno
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://putovnykruh.cz/#localbusiness',
  name: 'Putovní mužský kruh Blansko',
  description: 'Mužský kruh pro muže z Blanska, Brna a okolí. Setkání u ohně, sdílení, autentické rozhovory bez odsuzování.',
  image: logoUrl,
  url: 'https://putovnykruh.cz',
  telephone: '+420777347591',
  priceRange: 'FREE',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '49.3626',
    longitude: '16.6441'
  },
  areaServed: [
    {
      '@type': 'City',
      name: 'Blansko',
      containedInPlace: {
        '@type': 'Country',
        name: 'Česká republika'
      }
    },
    {
      '@type': 'City',
      name: 'Brno'
    },
    {
      '@type': 'City',
      name: 'Adamov'
    },
    {
      '@type': 'AdministrativeArea',
      name: 'okres Blansko'
    }
  ],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Mužský kruh',
      description: 'Bezpečný prostor pro muže pro sdílení, podporu a osobní růst. Pravidelná setkání u ohně.',
      areaServed: 'Blansko, Brno, Blanensko'
    },
    price: '0',
    priceCurrency: 'CZK'
  },
  keywords: 'mužský kruh Brno, mužský kruh Blansko, Blanensko, sdílení u ohně, muži Blansko, setkání mužů Brno, mužská podpora, kruh pro muže'
};

// Event Schema - for next circle meeting
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Putovní mužský kruh - Setkání',
  description: 'Setkání mužského kruhu u ohně. Bezpečný prostor pro autentické sdílení, naslouchání a osobní růst mužů z Blanska a Brna.',
  image: logoUrl,
  startDate: '2026-03-18T17:30:00+01:00',
  endDate: '2026-03-18T20:00:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Blansko - místo bude upřesněno',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Blansko',
      addressRegion: 'Jihomoravský kraj',
      addressCountry: 'CZ'
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: '49.3626',
      longitude: '16.6441'
    }
  },
  organizer: {
    '@type': 'Organization',
    name: 'Putovní mužský kruh',
    url: 'https://putovnykruh.cz'
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'CZK',
    availability: 'https://schema.org/InStock',
    url: 'https://putovnykruh.cz/#prihlaska',
    validFrom: new Date().toISOString()
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'Muži z Blanska, Brna a okolí'
  },
  keywords: 'mužský kruh Blansko, mužský kruh Brno, setkání mužů, sdílení u ohně, Blanensko',
  inLanguage: 'cs'
};

// Select schemas based on page type
const schemas = type === 'event' 
  ? [organizationSchema, localBusinessSchema, eventSchema]
  : [organizationSchema, localBusinessSchema];
---

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
