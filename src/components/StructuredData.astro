---
// Structured Data (Schema.org JSON-LD) for SEO
// Targets: Event schema for circle meetings, LocalBusiness for geo-targeting

interface Props {
  type?: 'homepage' | 'event';
}

const { type = 'homepage' } = Astro.props;

// Organization Schema - appears on all pages
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Putovný mužský kruh',
  description: 'Bezpečný priestor pre mužov na Blanensku a v Brne. Zdieľanie pri ohni, autentické rozhovory, mužská podpora.',
  url: 'https://putovnykruh.cz',
  logo: 'https://putovnykruh.cz/images/logo.jpg',
  areaServed: [
    {
      '@type': 'City',
      name: 'Blansko',
      '@id': 'https://www.wikidata.org/wiki/Q540666'
    },
    {
      '@type': 'City', 
      name: 'Brno',
      '@id': 'https://www.wikidata.org/wiki/Q14960'
    },
    {
      '@type': 'AdministrativeArea',
      name: 'Blanensko',
      containedIn: {
        '@type': 'Country',
        name: 'Česká republika'
      }
    }
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+421',
    contactType: 'customer support',
    availableLanguage: ['Slovak', 'Czech']
  },
  sameAs: [
    'https://chat.whatsapp.com/JVL1HKS5Jj0K8hsY5YBsL4'
  ]
};

// LocalBusiness Schema - for geo-targeting Blansko/Brno
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://putovnykruh.cz/#localbusiness',
  name: 'Putovný mužský kruh Blansko',
  description: 'Mužský kruh pre mužov z Blanska, Brna a okolia. Stretnutia pri ohni, zdieľanie, autentické rozhovory bez súdenia.',
  image: 'https://putovnykruh.cz/images/logo.jpg',
  url: 'https://putovnykruh.cz',
  telephone: '+421',
  priceRange: 'FREE',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '49.3626',
    longitude: '16.6441'
  },
  areaServed: [
    {
      '@type': 'City',
      name: 'Blansko',
      containedInPlace: {
        '@type': 'Country',
        name: 'Česká republika'
      }
    },
    {
      '@type': 'City',
      name: 'Brno'
    },
    {
      '@type': 'City',
      name: 'Adamov'
    },
    {
      '@type': 'AdministrativeArea',
      name: 'okres Blansko'
    }
  ],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Mužský kruh',
      description: 'Bezpečný priestor pre mužov na zdieľanie, podporu a osobný rast. Pravidelné stretnutia pri ohni.',
      areaServed: 'Blansko, Brno, Blanensko'
    },
    price: '0',
    priceCurrency: 'CZK'
  },
  keywords: 'mužský kruh Brno, mužský kruh Blansko, Blanensko, zdieľanie u ohňa, muži Blansko, stretnutia mužov Brno, mužská podpora, kruh pre mužov'
};

// Event Schema - for next circle meeting
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Putovný mužský kruh - Stretnutie',
  description: 'Stretnutie mužského kruhu pri ohni. Bezpečný priestor pre autentické zdieľanie, načúvanie a osobný rast mužov z Blanska a Brna.',
  image: 'https://putovnykruh.cz/images/logo.jpg',
  startDate: '2026-03-18T17:30:00+01:00',
  endDate: '2026-03-18T20:00:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Blansko - miesto bude upresnené',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Blansko',
      addressRegion: 'Jihomoravský kraj',
      addressCountry: 'CZ'
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: '49.3626',
      longitude: '16.6441'
    }
  },
  organizer: {
    '@type': 'Organization',
    name: 'Putovný mužský kruh',
    url: 'https://putovnykruh.cz'
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'CZK',
    availability: 'https://schema.org/InStock',
    url: 'https://putovnykruh.cz/#prihlaska',
    validFrom: new Date().toISOString()
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'Muži z Blanska, Brna a okolia'
  },
  keywords: 'mužský kruh Blansko, mužský kruh Brno, stretnutie mužov, zdieľanie pri ohni, Blanensko',
  inLanguage: 'sk'
};

// Select schemas based on page type
const schemas = type === 'event' 
  ? [organizationSchema, localBusinessSchema, eventSchema]
  : [organizationSchema, localBusinessSchema];
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
