const defaultEventDescription =
  'Setkání mužského kruhu u ohně. Bezpečný prostor pro autentické sdílení, naslouchání a osobní růst mužů z Blanska a Brna.';

function formatSchemaDateTime(date: Date): string {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/Prague',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
  }).formatToParts(date);

  const partValue = (type: Intl.DateTimeFormatPartTypes): string =>
    parts.find((part) => part.type === type)?.value ?? '00';

  const timeZoneNamePart = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Prague',
    timeZoneName: 'shortOffset',
  })
    .formatToParts(date)
    .find((part) => part.type === 'timeZoneName')?.value;

  const normalizedOffset = timeZoneNamePart?.replace(/^(GMT|UTC)/, '') ?? '+00:00';
  const offsetMatch = normalizedOffset.match(/^([+-])(\d{1,2})(?::?(\d{2}))?$/);

  const offset = offsetMatch
    ? `${offsetMatch[1]}${offsetMatch[2].padStart(2, '0')}:${(offsetMatch[3] ?? '00').padStart(2, '0')}`
    : '+00:00';

  const datePart = `${partValue('year')}-${partValue('month')}-${partValue('day')}`;
  const timePart = `${partValue('hour')}:${partValue('minute')}:${partValue('second')}`;

  return `${datePart}T${timePart}${offset}`;
}

const eventSchema = event
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: event.topic ? `Putovní mužský kruh - ${event.topic}` : 'Putovní mužský kruh - bude upřesněno',
      description: event.description || defaultEventDescription,
      image: logoUrl,
      startDate: formatSchemaDateTime(event.startsAt),
      endDate: formatSchemaDateTime(event.endsAt ?? new Date(event.startsAt.getTime() + 2.5 * 60 * 60 * 1000)),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: event.place,
        address: {
          '@type': 'PostalAddress',
          addressLocality: event.locality,
          addressRegion: event.addressRegion,
          addressCountry: event.addressCountry,
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: '49.3626',
          longitude: '16.6441',
        },
      },
      organizer: {
        '@type': 'Organization',
        name: 'Putovní mužský kruh',
        url: 'https://putovnykruh.cz',
      },
      performer: [
        {
          '@type': 'Person',
          name: 'Jožo',
        },
        {
          '@type': 'Person',
          name: 'Martin',
        },
      ],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'CZK',
        availability: 'https://schema.org/InStock',
        url: 'https://putovnykruh.cz/#prihlaska',
        validFrom: new Date().toISOString(),
      },
      audience: {
        '@type': 'Audience',
        audienceType: 'Muži z Blanska, Brna a okolí',
      },
      keywords: 'mužský kruh Blansko, mužský kruh Brno, setkání mužů, sdílení u ohně, Blanensko',
      inLanguage: 'cs',
    }
  : null;

// Select schemas based on page type
const schemas = type === 'event' && eventSchema
  ? [organizationSchema, localBusinessSchema, eventSchema]
  : [organizationSchema, localBusinessSchema];
---

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
