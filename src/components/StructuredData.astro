---
/**
 * JSON-LD for the whole site. Three types, one entity each:
 *   Organization — every page (single brand entity, referenced via @id)
 *   Event        — homepage, for the next circle
 *   BlogPosting  — article pages
 *
 * Deliberately NOT emitted:
 *   LocalBusiness — the circle has no fixed address or opening hours and the
 *   old hardcoded Blansko coordinates were wrong for circles held elsewhere
 *   (Adamov, Bílovice, Babí doly…). Address comes from the content collection.
 *   Event geo coordinates — same reason; PostalAddress is accurate, geo wasn't.
 */
import logoImage from '../assets/images/image03.jpg';

interface EventData {
  description: string;
  startsAt: Date;
  endsAt?: Date;
  place: string;
  locality: string;
  addressRegion: string;
  addressCountry: string;
  topic?: string;
  lat?: number;
  lng?: number;
  mapUrl?: string;
}

interface ArticleData {
  title: string;
  description: string;
  publishedAt: Date;
  author?: string;
  image?: string;
  url: string;
  lang?: 'cs' | 'sk';
}

interface Props {
  type?: 'website' | 'event' | 'article';
  event?: EventData | null;
  article?: ArticleData | null;
}

const { type = 'website', event = null, article = null } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://putovnykruh.cz');
const logoUrl = new URL(logoImage.src, siteUrl).toString();
const ORG_ID = 'https://putovnykruh.cz/#organization';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Putovní mužský kruh',
  url: 'https://putovnykruh.cz',
  logo: logoUrl,
  description:
    'Bezpečný prostor pro muže na Blanensku a v Brně. Sdílení u ohně, autentické rozhovory, mužská podpora.',
  email: 'info@putovnykruh.cz',
  areaServed: [
    { '@type': 'City', name: 'Blansko', '@id': 'https://www.wikidata.org/wiki/Q540666' },
    { '@type': 'City', name: 'Brno', '@id': 'https://www.wikidata.org/wiki/Q14960' },
    {
      '@type': 'AdministrativeArea',
      name: 'Blanensko',
      containedIn: { '@type': 'Country', name: 'Česká republika' },
    },
  ],
  founder: [
    { '@type': 'Person', name: 'Jožo' },
    { '@type': 'Person', name: 'Martin' },
  ],
  sameAs: ['https://chat.whatsapp.com/JVL1HKS5Jj0K8hsY5YBsL4'],
};

function formatSchemaDateTime(date: Date): string {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/Prague',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
  }).formatToParts(date);

  const partValue = (type: Intl.DateTimeFormatPartTypes): string =>
    parts.find((part) => part.type === type)?.value ?? '00';

  const timeZoneNamePart = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Prague',
    timeZoneName: 'shortOffset',
  })
    .formatToParts(date)
    .find((part) => part.type === 'timeZoneName')?.value;

  const normalizedOffset = timeZoneNamePart?.replace(/^(GMT|UTC)/, '') ?? '+00:00';
  const offsetMatch = normalizedOffset.match(/^([+-])(\d{1,2})(?::?(\d{2}))?$/);

  const offset = offsetMatch
    ? `${offsetMatch[1]}${offsetMatch[2].padStart(2, '0')}:${(offsetMatch[3] ?? '00').padStart(2, '0')}`
    : '+00:00';

  const datePart = `${partValue('year')}-${partValue('month')}-${partValue('day')}`;
  const timePart = `${partValue('hour')}:${partValue('minute')}:${partValue('second')}`;

  return `${datePart}T${timePart}${offset}`;
}

const eventSchema =
  type === 'event' && event
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: event.topic ? `Putovní mužský kruh – ${event.topic}` : 'Putovní mužský kruh',
        description:
          event.description ||
          'Setkání mužského kruhu u ohně. Bezpečný prostor pro autentické sdílení, naslouchání a osobní růst mužů z Blanska a Brna.',
        image: logoUrl,
        startDate: formatSchemaDateTime(event.startsAt),
        endDate: formatSchemaDateTime(
          event.endsAt ?? new Date(event.startsAt.getTime() + 2.5 * 60 * 60 * 1000),
        ),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: {
          '@type': 'Place',
          name: event.place,
          address: {
            '@type': 'PostalAddress',
            addressLocality: event.locality,
            addressRegion: event.addressRegion,
            addressCountry: event.addressCountry,
          },
          ...(event.lat != null && event.lng != null
            ? {
                geo: {
                  '@type': 'GeoCoordinates',
                  latitude: event.lat,
                  longitude: event.lng,
                },
              }
            : {}),
          ...(event.mapUrl ? { hasMap: event.mapUrl } : {}),
        },
        organizer: { '@id': ORG_ID },
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'CZK',
          availability: 'https://schema.org/InStock',
          url: 'https://putovnykruh.cz/#prihlaska',
        },
        audience: { '@type': 'Audience', audienceType: 'Muži z Blanska, Brna a okolí' },
        inLanguage: 'cs',
      }
    : null;

const articleSchema =
  type === 'article' && article
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: article.title,
        description: article.description,
        datePublished: article.publishedAt.toISOString(),
        dateModified: article.publishedAt.toISOString(),
        inLanguage: article.lang ?? 'cs',
        url: article.url,
        mainEntityOfPage: { '@type': 'WebPage', '@id': article.url },
        image: article.image ? new URL(article.image, siteUrl).toString() : logoUrl,
        author: article.author
          ? { '@type': 'Person', name: article.author }
          : { '@type': 'Organization', '@id': ORG_ID, name: 'Putovní mužský kruh' },
        publisher: {
          '@type': 'Organization',
          '@id': ORG_ID,
          name: 'Putovní mužský kruh',
          logo: { '@type': 'ImageObject', url: logoUrl },
        },
        isPartOf: {
          '@type': 'Blog',
          '@id': 'https://putovnykruh.cz/blog/',
          name: 'Blog Putovního mužského kruhu',
        },
      }
    : null;

const schemas = [organizationSchema, eventSchema, articleSchema].filter((schema) => schema !== null);
---

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
