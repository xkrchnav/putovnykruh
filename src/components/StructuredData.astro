---
// Structured Data (Schema.org JSON-LD) for SEO
// Targets: Event schema for circle meetings, LocalBusiness for geo-targeting

interface Props {
  type?: 'homepage' | 'event';
  event?: {
    description: string;
    startsAt: Date;
    endsAt?: Date;
    place: string;
    locality: string;
    addressRegion: string;
    addressCountry: string;
    topic?: string;
  } | null;
}

