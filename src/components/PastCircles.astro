---
/**
 * Past Circles - compact, collapsible history
 */
import { Image } from "astro:assets";
import { render } from 'astro:content';
import type { CircleEntry } from '../lib/circles';
import { formatCircleDate } from '../lib/circles';

interface Props {
  circles: CircleEntry[];
}

const { circles } = Astro.props;

const renderedCircles = await Promise.all(
  circles.map(async (circle) => {
    const { Content } = await render(circle);
    return { circle, Content };
  }),
);
---

<section class="section" aria-labelledby="minule-title">
  <div class="container">
    <h2 id="minule-title">Minulé kruhy</h2>
    <hr class="divider" />
    <p class="past__intro">
      Každý kruh je jiný. Tady jsou naše dosavadní setkání.
    </p>

    <div class="past__timeline">
      {renderedCircles.map(({ circle, Content }) => (
        <article class="past-event">
          <div class="past-event__header">
            <span class="past-event__date">{formatCircleDate(circle.data.startsAt)}</span>
            <span class="past-event__location">{circle.data.place}</span>
          </div>
          <h3>{circle.data.title}</h3>
          <p>{circle.data.description}</p>

          <div class="past-event__body prose">
            <Content />
          </div>

          {
            circle.data.gallery.length > 0 && (
              <div class={`gallery ${circle.data.gallery.length >= 4 ? 'gallery--four' : ''}`}>
                {circle.data.gallery.map((image: CircleEntry['data']['gallery'][number]) => (
                  <Image
                    src={image.src}
                    alt={image.alt}
                    width={800}
                    height={900}
                    loading="lazy"
                    format="webp"
                  />
                ))}
              </div>
            )
          }
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .past__intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xl);
  }

  .past__timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .past-event {
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-border);
    transition: border-color var(--transition-base);
  }

  .past-event:hover {
    border-left-color: var(--color-fire);
  }

  .past-event__header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .past-event__date {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .past-event__location {
    font-size: 0.85rem;
    color: var(--color-text-dim);
  }

  .past-event h3 {
    font-size: 1.15rem;
    letter-spacing: 0.03em;
    text-transform: none;
    color: var(--color-heading);
    margin-bottom: var(--space-sm);
  }

  .past-event > p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .past-event__body {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .past-event__body :global(p) {
    margin-bottom: var(--space-sm);
  }

  .past-event__body :global(a) {
    color: var(--color-accent);
  }
</style>
