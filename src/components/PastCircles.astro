---
/**
 * Archiv kruhů — rozcestník. Plné texty a fotky mají vlastní stránky
 * (/kruh/<slug>/), tady zůstává datum, místo, téma a odkaz.
 */
import type { CircleEntry } from '../lib/circles';
import { circleTopicLabel, formatCircleDate } from '../lib/circles';
import { resolvePlace } from '../lib/places';

interface Props {
  circles: CircleEntry[];
  headingLevel?: 'h1' | 'h2';
  backHref?: string;
  backLabel?: string;
}

const { circles, headingLevel = 'h2', backHref, backLabel } = Astro.props;

const HeadingTag = headingLevel;
const titleId = 'minule-kruhy-title';

const items = circles.map((circle) => ({ circle, place: resolvePlace(circle.data) }));
---

<section class="section" aria-labelledby={titleId}>
  <div class="container">
    {backHref && backLabel && <a href={backHref} class="back-link">{backLabel}</a>}

    <HeadingTag id={titleId}>Minulé kruhy</HeadingTag>
    <hr class="divider" />
    <p class="past__intro">
      Každý kruh je jiný. Tady jsou naše dosavadní setkání — klikni na téma a uvidíš, co se tenkrát řešilo.
    </p>

    {
      items.length > 0 ? (
        <div class="past__timeline">
          {items.map(({ circle, place }) => (
            <article class="past-event">
              <div class="past-event__header">
                <span class="past-event__date">{formatCircleDate(circle.data.startsAt)}</span>
                <span class="past-event__location">{place.name}</span>
              </div>
              <h3>
                <a href={`/kruh/${circle.id}/`}>{circleTopicLabel(circle)}</a>
              </h3>
              {circle.data.description && <p class="past-event__body">{circle.data.description}</p>}
              <a class="past-event__link" href={`/kruh/${circle.id}/`}>
                Co jsme spolu prošli →
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="past__empty">Archiv se teprve plní. Až proběhnou první kruhy, najdeš je tady.</p>
      )
    }
  </div>
</section>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .past__intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xl);
  }

  .past__empty {
    padding: var(--space-xl);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .past__timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .past-event {
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-border);
    transition: border-color var(--transition-base);
  }

  .past-event:hover {
    border-left-color: var(--color-fire);
  }

  .past-event__header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .past-event__date {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .past-event__location {
    font-size: 0.85rem;
    color: var(--color-text-dim);
  }

  .past-event h3 {
    font-size: 1.15rem;
    letter-spacing: 0.03em;
    text-transform: none;
    color: var(--color-heading);
    margin-bottom: var(--space-sm);
  }

  .past-event h3 a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .past-event h3 a:hover {
    color: var(--color-accent);
  }

  .past-event__body {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  .past-event__link {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .past-event__link:hover {
    color: var(--color-accent);
  }
</style>
