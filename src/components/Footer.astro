        WhatsApp
      </a>
      <a href="/#prihlaska" class="btn btn--primary">Přihlásit se na kruh</a>
    </div>

    <div class="footer__contact">
      <p>SMS &ndash; <a href="tel:+420777347591">777 347 591</a></p>
      <p>e-mail &ndash; <a href="mailto:info@putovnykruh.cz">info@putovnykruh.cz</a></p>
    </div>

    <p class="footer__copy">Putovní kruh &ndash; okres Blansko</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-3xl) var(--space-2xl);
    border-top: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .footer__fire {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40rem;
    height: 20rem;
    background: radial-gradient(ellipse at 50% 100%, rgba(180, 60, 0, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .footer__content {
    text-align: center;
    position: relative;
  }

  .footer__tagline {
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: linear-gradient(135deg, var(--color-fire-bright), var(--color-accent), #ffaa44);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-2xl);
  }

  .footer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 30rem) {
    .footer__actions {
      flex-direction: row;
      justify-content: center;
    }
  }

  .footer__whatsapp {
    display: inline-flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .footer__whatsapp svg {
    flex-shrink: 0;
  }

  .footer__contact {
    margin-bottom: var(--space-lg);
  }

  .footer__contact p {
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .footer__contact a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__contact a:hover {
    color: var(--color-accent);
  }

  .footer__copy {
    font-size: 0.8rem;
    color: var(--color-text-dim);
    letter-spacing: 0.05em;
  }
</style>
