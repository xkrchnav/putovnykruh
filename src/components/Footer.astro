<style>
  .site-footer {
    padding-bottom: var(--space-2xl);
  }

  .footer__content {
    text-align: center;
  }

  .footer__tagline {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .footer__whatsapp {
    display: inline-flex;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-lg);
  }

  .footer__whatsapp svg {
    flex-shrink: 0;
  }

  .footer__contact {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
  }
</style>
