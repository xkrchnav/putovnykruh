---
/**
 * Testimonials - condensed, powerful social proof
 * Only 3 best quotes, bigger text, more impact
 */
---

<section id="skusenosti" class="section" aria-labelledby="skusenosti-title">
  <div class="container">
    <h2 id="skusenosti-title">Co říkají chlapi</h2>
    <hr class="divider" />

    <div class="testimonials__grid">
      <blockquote class="testimonial">
        <p class="testimonial__text">
          &bdquo;Tady můžu otevírat témata, který by v&nbsp;hospodě nepřipadaly
          v&nbsp;úvahu. Tím, že &bdquo;putujeme&ldquo;, vždycky to má někdo
          skoro za domem. Platím jen svým časem a&nbsp;slovem 🙂&ldquo;
        </p>
        <footer class="testimonial__author">
          <cite>Jirka, <span data-member-age data-born-year="1991"></span></cite
          >
          <span class="testimonial__location">Bílovice nad Svitavou</span>
        </footer>
      </blockquote>
    </div>
  </div>
</section>

<script is:inline>
  const memberAgeElements = document.querySelectorAll("[data-member-age]");

  memberAgeElements.forEach((element) => {
    const bornYear = Number(element.getAttribute("data-born-year"));
    const currentYear = new Date().getFullYear();
    if (!Number.isNaN(bornYear)) {
      element.textContent = String(currentYear - bornYear);
    }
  });
</script>

<style>
  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  @media (min-width: 50rem) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .testimonial {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-fire);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .testimonial:hover {
    border-left-color: var(--color-fire-bright);
    box-shadow: 0 0 30px rgba(255, 80, 0, 0.08);
  }

  .testimonial__text {
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.85;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .testimonial__author {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .testimonial__author cite {
    font-style: normal;
    font-weight: 600;
    color: var(--color-heading);
    font-size: 1rem;
  }

  .testimonial__location {
    font-size: 0.85rem;
    color: var(--color-text-dim);
    letter-spacing: 0.05em;
  }
</style>
