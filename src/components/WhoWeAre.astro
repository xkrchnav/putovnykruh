---
/**
 * Who we are - founder trust section (SEO/E-E-A-T support)
 * Uses real founder portraits
 */
import { Image } from 'astro:assets';
import jozoPhoto from '../assets/images/jozo.jpg';
import martinPhoto from '../assets/images/martin.jpeg';
---

<section id="kdo-jsme" class="section founders" aria-labelledby="kdo-jsme-title">
  <div class="container">
    <h2 id="kdo-jsme-title">Kdo jsme</h2>
    <hr class="divider" />

    <p class="founders__intro">
      Chodili jsme na kruhy dlouho a postupně nám začalo dávat hluboký smysl posunout to dál.
      Přinést tenhle způsob setkávání do našich končin — a otevřít ho i dalším mužům, kteří hledají
      opravdovost, oporu a směr.
    </p>

    <div class="founders__grid">
      <article class="founder card">
        <Image
          src={jozoPhoto}
          alt="Spoluzakladatel Jožo při mužském kruhu"
          class="founder__photo"
          width={506}
          height={900}
          loading="lazy"
          format="webp"
        />
        <h3>Jožo, <span data-founder-age data-born-year="1985"></span></h3>
        <p>
          Mám rád zdieľanie v kruhu. Pomerne dlho mi trvalo než som prišiel na to, čo znamená to, že muž sa môže stávať mužom len v prítomnosti iných mužov.
          Po rozvode rodičov som cca od 12 rokov bez otca. Myslel som si, že mi mamka dá všetko, čo potrebujem. Aj keď som časom na rôznych seminároch počul, že muž potrebuje muža, nechápal som to. V duchu som obhajoval mamku a "lhal si do kapsy", hľa aký chlap zo mňa vyrástol.
          Keď sa mi teraz kopia rôzne témy, ktorými nechcem zaťažovať svoju ženu, ale potrebujem sa o nich porozprávať, viem, že mám kam ísť. A to je úžasné. Som veľmi vďačný, že s Martinom môžeme držať tento priestor.
        </p>
      </article>

      <article class="founder card">
        <Image
          src={martinPhoto}
          alt="Spoluzakladatel Martin při mužském kruhu"
          class="founder__photo"
          width={506}
          height={900}
          loading="lazy"
          format="webp"
        />
        <h3>Martin, <span data-founder-age data-born-year="1988"></span></h3>
        <p>

        </p>
      </article>
    </div>
  </div>
</section>

<script is:inline>
  const founderAgeElements = document.querySelectorAll('[data-founder-age]');

  founderAgeElements.forEach((element) => {
    const bornYear = Number(element.getAttribute('data-born-year'));
    const currentYear = new Date().getFullYear();
    if (!Number.isNaN(bornYear)) {
      element.textContent = String(currentYear - bornYear);
    }
  });
</script>

<style>
  .founders {
    background: radial-gradient(ellipse at 50% 0%, rgba(180, 60, 0, 0.08) 0%, transparent 55%);
  }

  .founders__intro {
    max-width: 40rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .founders__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .founders__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .founder {
    padding: 0;
    overflow: hidden;
  }

  .founder__photo {
    width: 100%;
    height: 18rem;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border);
  }

  .founder h3,
  .founder p {
    padding-inline: var(--space-lg);
  }

  .founder h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .founder p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    font-size: 0.98rem;
  }

</style>
