---
/**
 * Contact form - alternative to signup, for those who just want notifications
 */
---

<section id="kontakt" class="section" aria-labelledby="kontakt-title">
  <div class="container contact">
    <h3 id="kontakt-title">Nechceš byť v&nbsp;WhatsApp skupine?</h3>
    <hr class="divider" />
    <p class="contact__desc">
      Nechaj nám kontakt. Pošleme ti len pozvánku na&nbsp;najbližší kruh. Žiadny spam.
    </p>

    <form class="contact__form" id="contact__form" method="post" action="#" novalidate>
      <div class="contact__fields">
        <div>
          <label for="form-meno" class="sr-only">Meno</label>
          <input
            type="text"
            id="form-meno"
            name="meno"
            placeholder="Meno"
            maxlength="256"
            required
            class="form-field"
            autocomplete="name"
          />
        </div>
        <div>
          <label for="form-kontakt" class="sr-only">Telefón alebo e-mail</label>
          <input
            type="text"
            id="form-kontakt"
            name="kontakt"
            placeholder="Telefón alebo e-mail"
            maxlength="128"
            required
            class="form-field"
            autocomplete="email"
          />
        </div>
      </div>
      <button type="submit" class="btn btn--primary contact__submit">
        Chcem dostávať pozvánky
      </button>

      <div class="contact__message" id="contact__message" role="alert" aria-live="polite"></div>

      <p class="contact__privacy">
        Tvoje údaje slúžia výhradne na informácie o&nbsp;stretnutiach.
      </p>
    </form>
  </div>
</section>

<style>
  .contact {
    max-width: 36rem;
    text-align: center;
  }

  .contact .divider {
    margin-inline: auto;
  }

  .contact__desc {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    font-size: 1.05rem;
  }

  .contact__form {
    margin-top: var(--space-lg);
  }

  .contact__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 30rem) {
    .contact__fields {
      flex-direction: row;
    }

    .contact__fields > div {
      flex: 1;
    }
  }

  .contact__submit {
    width: 100%;
  }

  .contact__privacy {
    font-size: 0.8rem;
    color: var(--color-text-dim);
    margin-top: var(--space-md);
  }

  .contact__message {
    margin-top: var(--space-md);
    padding: var(--space-md);
    border-radius: 0.375rem;
    font-size: 0.95rem;
    text-align: center;
    display: none;
  }

  .contact__message.visible {
    display: block;
  }

  .contact__message.success {
    background-color: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: rgb(34, 197, 94);
  }

  .contact__message.error {
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: rgb(239, 68, 68);
  }

  .contact__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>

<script>
  interface FormElements extends HTMLFormControlsCollection {
    meno: HTMLInputElement;
    kontakt: HTMLInputElement;
  }

  interface ContactForm extends HTMLFormElement {
    readonly elements: FormElements;
  }

  const GOOGLE_SHEET_URL = 'https://script.google.com/macros/s/AKfycbzq6EXYaEBPTRArInio4-FG71hrA_98bKAFft9Fpf-J3uk71BODVkFvm3DO2XvMMLYb/exec';

  function showMessage(message: string, type: 'success' | 'error'): void {
    const messageEl = document.getElementById('contact__message');
    if (!messageEl) return;

    messageEl.textContent = message;
    messageEl.className = `contact__message visible ${type}`;

    // Auto-hide success message after 5 seconds
    if (type === 'success') {
      setTimeout(() => {
        messageEl.classList.remove('visible');
      }, 5000);
    }
  }

  function validateEmail(email: string): boolean {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  }

  function validatePhone(phone: string): boolean {
    // Slovak phone number format (with or without prefix)
    const phoneRegex = /^(\+421|00421|0)?[0-9]{9}$/;
    return phoneRegex.test(phone.replace(/\s/g, ''));
  }

  function validateKontakt(kontakt: string): boolean {
    const trimmed = kontakt.trim();
    return validateEmail(trimmed) || validatePhone(trimmed);
  }

  async function handleSubmit(event: Event): Promise<void> {
    event.preventDefault();

    const form = event.target as ContactForm;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const messageEl = document.getElementById('contact__message');

    // Validate form
    const meno = form.elements.meno.value.trim();
    const kontakt = form.elements.kontakt.value.trim();

    if (!meno) {
      showMessage('Prosím, zadaj svoje meno.', 'error');
      form.elements.meno.focus();
      return;
    }

    if (!kontakt) {
      showMessage('Prosím, zadaj telefón alebo e-mail.', 'error');
      form.elements.kontakt.focus();
      return;
    }

    if (!validateKontakt(kontakt)) {
      showMessage('Prosím, zadaj platný telefón alebo e-mail.', 'error');
      form.elements.kontakt.focus();
      return;
    }

    // Disable submit button
    submitButton.disabled = true;
    submitButton.textContent = 'Odosielam...';

    try {
      const formData = new FormData();
      formData.append('meno', meno);
      formData.append('kontakt', kontakt);
      formData.append('timestamp', new Date().toISOString());

      const response = await fetch(GOOGLE_SHEET_URL, {
        method: 'POST',
        body: formData,
        mode: 'no-cors', // Google Apps Script requires no-cors mode
      });

      // With no-cors, we can't read the response, so we assume success if no error was thrown
      showMessage('Ďakujeme! Budeme ťa informovať o najbližšom kruhu.', 'success');
      form.reset();

      // Optional: Scroll to success message
      if (messageEl) {
        messageEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } catch (error) {
      console.error('Form submission error:', error);
      showMessage('Niečo sa pokazilo. Skús to prosím znova.', 'error');
    } finally {
      // Re-enable submit button
      submitButton.disabled = false;
      submitButton.textContent = 'Chcem dostávať pozvánky';
    }
  }

  // Attach event listener to the form
  const contactForm = document.getElementById('contact__form') as ContactForm | null;
  if (contactForm) {
    contactForm.addEventListener('submit', handleSubmit);
  }
</script>
