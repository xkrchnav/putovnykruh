---
/**
 * Schedule + Signup form - the core conversion section
 * Next circle date + inline signup form (commitment-based)
 */
import type { CircleEntry } from "../lib/circles";
import { circleTopicLabel, formatCircleDateTime } from "../lib/circles";
import { render } from "astro:content";

interface Props {
  nextCircle: CircleEntry;
  nextUpcomingCircles?: CircleEntry[];
}

const { nextCircle, nextUpcomingCircles = [] } = Astro.props;

const nextCircleTopic = circleTopicLabel(nextCircle);
const { Content } = await render(nextCircle);
const upcomingLabel =
  nextUpcomingCircles.length > 1 ? "Další termíny" : "Další termín";
---

<section
  id="prihlaska"
  class="section signup-section"
  aria-labelledby="prihlaska-title"
>
  <div class="container">
    <div class="signup__hero">
      <h2 id="prihlaska-title">Nejbližší kruh</h2>
      <hr class="divider" />
    </div>

    <div class="signup__card card">
      <div class="signup__details">
        <div class="signup__meta">
          <div class="signup__meta-item">
            <span class="signup__meta-label">Kdy</span>
            <span class="signup__meta-value"
              >{formatCircleDateTime(nextCircle.data.startsAt)}</span
            >
          </div>
          <div class="signup__meta-item">
            <span class="signup__meta-label">Kde</span>
            <span class="signup__meta-value">{nextCircle.data.place}</span>
          </div>
          <div class="signup__meta-item">
            <span class="signup__meta-label">Téma</span>
            <span class="signup__meta-value">{nextCircleTopic}</span>
          </div>
        </div>
        <p class="signup__desc">
          {nextCircle.data.description}
        </p>
        <div class="signup__content prose">
          <Content />
          <p>Téma je pouze vodítko.</p>
          <ul class="styled-list">
            <li>Příchod ideálně 10 minut před začátkem</li>
            <li>Otevřenost bez hodnocení a bez rad na sílu</li>
            <li>Diskrétnost: co zazní v kruhu, zůstává v kruhu</li>
          </ul>
        </div>
      </div>

      <hr class="divider--wide" />

      <div class="signup__form-wrap">
        <h3 class="signup__form-title">Dej své slovo</h3>
        <p class="signup__form-desc">
          Tvoje přihláška není kliknutí. Je to <strong>mužské slovo</strong> &ndash;
          závazek vůči sobě a&nbsp;ostatním. Počítáme s&nbsp;tebou.
        </p>

        <form
          class="signup__form"
          id="signup__form"
          method="post"
          action="#"
          novalidate
        >
          <div class="signup__fields">
            <div>
              <label for="signup-meno" class="sr-only">Jméno</label>
              <input
                type="text"
                id="signup-meno"
                name="meno"
                placeholder="Tvoje jméno"
                maxlength="256"
                required
                class="form-field"
                autocomplete="name"
              />
            </div>
            <div>
              <label for="signup-kontakt" class="sr-only"
                >Telefon nebo e-mail</label
              >
              <input
                type="text"
                id="signup-kontakt"
                name="kontakt"
                placeholder="Telefon nebo e-mail"
                maxlength="128"
                required
                class="form-field"
                autocomplete="tel"
              />
            </div>
          </div>

          <div class="signup__commitment">
            <label class="signup__checkbox">
              <input type="checkbox" name="slovo" required />
              <span>Dávám své slovo, že přijdu.</span>
            </label>
          </div>

          <button
            type="submit"
            class="btn btn--primary btn--large signup__submit"
          >
            <span class="signup__submit-line">Zavazuji se,</span>
            <span class="signup__submit-line signup__submit-line--break"
              >přijdu</span
            >
          </button>

          <div
            class="signup__message"
            id="signup__message"
            role="alert"
            aria-live="polite"
          >
          </div>

          <p class="signup__note">
            Všechno je zdarma. Žádné poplatky. Jen tvoje přítomnost
            a&nbsp;odvaha.
          </p>
        </form>

        <div class="signup__alt signup__alt--mobile">
          <p>
            Nebo se připoj přes <a
              href="https://chat.whatsapp.com/JVL1HKS5Jj0K8hsY5YBsL4"
              target="_blank"
              rel="noopener noreferrer">WhatsApp skupinu</a
            >.
          </p>
        </div>

        <div class="signup__alt signup__alt--desktop">
          <p>Nebo se připoj přes WhatsApp:</p>
          <a
            href="https://chat.whatsapp.com/JVL1HKS5Jj0K8hsY5YBsL4"
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp skupina
          </a>
        </div>
      </div>
    </div>

    <div class="signup__upcoming">
      <p class="signup__upcoming-label">{upcomingLabel}</p>
      {
        nextUpcomingCircles.length > 0 ? (
          <ul class="signup__upcoming-list">
            {nextUpcomingCircles.map((circle) => {
              const topic = circleTopicLabel(circle);

              return (
                <li class="signup__upcoming-item">
                  <p class="signup__upcoming-date">
                    <strong>
                      {formatCircleDateTime(circle.data.startsAt)}
                    </strong>{" "}
                    &ndash; {circle.data.place}
                    {topic ? `, ${topic}` : ""}
                  </p>
                  <p class="signup__upcoming-desc">{circle.data.description}</p>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="signup__upcoming-date">Další termín bude brzy vypsán.</p>
        )
      }
    </div>
  </div>
</section>

<style>
  .signup-section {
    background: radial-gradient(
      ellipse at 50% 0%,
      rgba(180, 60, 0, 0.08) 0%,
      transparent 50%
    );
  }

  .signup__hero {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .signup__hero .divider {
    margin-inline: auto;
  }

  .signup__card {
    padding: var(--space-2xl) var(--space-xl);
    border-color: rgba(255, 100, 30, 0.15);
  }

  .signup__meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 30rem) {
    .signup__meta {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .signup__meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .signup__meta-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .signup__meta-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .signup__desc {
    font-size: 1.05rem;
    margin-bottom: var(--space-md);
  }

  .signup__content {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .signup__form-wrap {
    text-align: center;
  }

  .signup__form-title {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    background: linear-gradient(
      135deg,
      var(--color-fire-bright),
      var(--color-accent)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-md);
  }

  .signup__form-desc {
    max-width: 32rem;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
  }

  .signup__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 28rem;
    margin-inline: auto;
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 30rem) {
    .signup__fields {
      flex-direction: row;
    }

    .signup__fields > div {
      flex: 1;
    }
  }

  .signup__commitment {
    margin-bottom: var(--space-lg);
  }

  .signup__checkbox {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    cursor: pointer;
    font-size: 1rem;
    color: var(--color-text);
  }

  .signup__checkbox input {
    width: 1.2rem;
    height: 1.2rem;
    accent-color: var(--color-fire);
    cursor: pointer;
  }

  .signup__submit {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35em;
    width: 100%;
    max-width: 28rem;
  }

  .signup__submit-line {
    white-space: nowrap;
  }

  .signup__submit-line--break {
    flex-basis: 100%;
  }

  @media (min-width: 30rem) {
    .signup__submit {
      flex-wrap: nowrap;
    }

    .signup__submit-line--break {
      flex-basis: auto;
    }
  }

  .signup__note {
    margin-top: var(--space-md);
    font-size: 0.85rem;
    color: var(--color-text-dim);
  }

  .signup__message {
    margin-top: var(--space-md);
    padding: var(--space-md);
    border-radius: 0.375rem;
    font-size: 0.95rem;
    text-align: center;
    display: none;
  }

  .signup__message.visible {
    display: block;
  }

  .signup__message.success {
    background-color: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: rgb(34, 197, 94);
  }

  .signup__message.error {
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: rgb(239, 68, 68);
  }

  .signup__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .signup__alt {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .signup__alt p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .signup__alt--mobile a {
    color: #25d366;
    font-weight: 600;
    text-decoration: underline;
  }

  .signup__alt--mobile {
    display: block;
  }

  .signup__alt--desktop {
    display: none;
  }

  @media (min-width: 30rem) {
    .signup__alt--mobile {
      display: none;
    }

    .signup__alt--desktop {
      display: block;
    }
  }

  .signup__upcoming {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background-color: var(--color-surface);
    border-radius: 0.375rem;
    border-left: 3px solid var(--color-accent);
    text-align: center;
  }

  .signup__upcoming-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .signup__upcoming-date {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .signup__upcoming-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .signup__upcoming-item + .signup__upcoming-item {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .signup__upcoming-desc {
    color: var(--color-text-muted);
    margin-bottom: 0;
    font-size: 0.95rem;
  }
</style>

<script>
  interface FormElements extends HTMLFormControlsCollection {
    meno: HTMLInputElement;
    kontakt: HTMLInputElement;
    slovo: HTMLInputElement;
  }

  interface SignupForm extends HTMLFormElement {
    readonly elements: FormElements;
  }

  const GOOGLE_SHEET_URL =
    "https://script.google.com/macros/s/AKfycbxuz-7bQYjVz3YlGAHslGdCIDUFI8tZd7XUnGMK8Vnb9LIRudL_Wet6EXQe6s4RuoPLiA/exec";

  function showMessage(message: string, type: "success" | "error"): void {
    const messageEl = document.getElementById("signup__message");
    if (!messageEl) return;

    messageEl.textContent = message;
    messageEl.className = `signup__message visible ${type}`;

    // Auto-hide success message after 5 seconds
    if (type === "success") {
      setTimeout(() => {
        messageEl.classList.remove("visible");
      }, 5000);
    }
  }

  function validateEmail(email: string): boolean {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  }

  function validatePhone(phone: string): boolean {
    // Czech/Slovak phone number format (with or without prefix)
    const phoneRegex = /^(\+420|00420|\+421|00421|0)?[0-9]{9}$/;
    return phoneRegex.test(phone.replace(/\s/g, ""));
  }

  function validateKontakt(kontakt: string): boolean {
    const trimmed = kontakt.trim();
    return validateEmail(trimmed) || validatePhone(trimmed);
  }

  async function handleSubmit(event: Event): Promise<void> {
    event.preventDefault();

    const form = event.target as SignupForm;
    const submitButton = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const initialSubmitMarkup = submitButton.innerHTML;
    const messageEl = document.getElementById("signup__message");

    // Validate form
    const meno = form.elements.meno.value.trim();
    const kontakt = form.elements.kontakt.value.trim();
    const slovo = form.elements.slovo.checked;

    if (!meno) {
      showMessage("Prosím, zadej svoje jméno.", "error");
      form.elements.meno.focus();
      return;
    }

    if (!kontakt) {
      showMessage("Prosím, zadej telefon nebo e-mail.", "error");
      form.elements.kontakt.focus();
      return;
    }

    if (!validateKontakt(kontakt)) {
      showMessage("Prosím, zadej platný telefon nebo e-mail.", "error");
      form.elements.kontakt.focus();
      return;
    }

    if (!slovo) {
      showMessage("Musíš dát své slovo, že přijdeš.", "error");
      form.elements.slovo.focus();
      return;
    }

    // Disable submit button
    submitButton.disabled = true;
    submitButton.textContent = "Odesílám...";

    try {
      const formData = new FormData();
      formData.append("meno", meno);
      formData.append("kontakt", kontakt);
      formData.append("slovo", "ano");
      formData.append("timestamp", new Date().toISOString());

      await fetch(GOOGLE_SHEET_URL, {
        method: "POST",
        body: formData,
        mode: "no-cors", // Google Apps Script requires no-cors mode
      });

      // With no-cors, we can't read the response, so we assume success if no error was thrown
      showMessage("Tvoje slovo bylo přijato! Počítáme s tebou. 🔥", "success");
      form.reset();

      // Optional: Scroll to success message
      if (messageEl) {
        messageEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    } catch (error) {
      console.error("Form submission error:", error);
      showMessage(
        "Něco se pokazilo. Zkus to prosím znovu nebo se připoj přes WhatsApp.",
        "error",
      );
    } finally {
      // Re-enable submit button
      submitButton.disabled = false;
      submitButton.innerHTML = initialSubmitMarkup;
    }
  }

  // Attach event listener to the form
  const signupForm = document.getElementById(
    "signup__form",
  ) as SignupForm | null;
  if (signupForm) {
    signupForm.addEventListener("submit", handleSubmit);
  }
</script>
