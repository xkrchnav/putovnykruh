---
/**
 * Hero section - logo, title, subtitle, intro text
 * Marketing-first: strong value proposition, emotional hook
 */
import { Image } from 'astro:assets';
import heroLogo from '../assets/images/image03.jpg';
---

<section id="domov" class="hero section" aria-labelledby="hero-title">
  <div class="container hero__content">
    <Image
      src={heroLogo}
      alt="Logo Putovneho kruhu - ohen a kruh muzov"
      class="hero__logo"
      width={128}
      height={128}
      loading="eager"
      format="webp"
    />
    <h1 id="hero-title">Putovny kruh</h1>
    <hr class="divider" />
    <p class="hero__subtitle">Muzsky kruh &ndash; okres Blansko</p>
    <p class="hero__intro">
      Toto je priestor pre muzov, ktori hladaju viac nez len povrchne debaty.
      Priestor, kde mozeme odlozit svoje masky, hovorit pravdu a nacuvat bez
      sudenia. Stretavame sa pri ohni, aby sme nasli spojenie sami so sebou a s
      ostatnymi chlapmi na svojej ceste.
    </p>
    <div class="hero__cta">
      <a href="#terminy" class="btn btn--primary">Najblizsi kruh</a>
      <a href="#skusenosti" class="btn">Co hovoria chlapi</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    padding-top: calc(3.5rem + var(--space-3xl));
    text-align: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 36rem;
  }

  .hero__logo {
    width: 7rem;
    height: auto;
    border-radius: 0.5rem;
    margin-bottom: var(--space-xl);
  }

  .hero .divider {
    margin-block: var(--space-md);
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 300;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xl);
  }

  .hero__intro {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: var(--space-2xl);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }
</style>
