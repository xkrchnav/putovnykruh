---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PastCircles from '../components/PastCircles.astro';
import { getCirclesState } from '../lib/circles';

const { pastCircles } = await getCirclesState();
---

<BaseLayout
  title="Minulé kruhy: archiv setkání | Blansko a Brno"
  description="Archiv setkání mužského kruhu u ohně — témata, místa a ohlédnutí z Blanenska a Brna. Kde jsme už byli a jak to vypadalo."
>
  <Header />
  <main>
    <PastCircles
      circles={pastCircles}
      headingLevel="h1"
      backHref="/"
      backLabel="← Zpět na hlavní stránku"
    />
  </main>
  <Footer />
</BaseLayout>
