---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import Testimonials from '../components/Testimonials.astro';
import Schedule from '../components/Schedule.astro';
import Pillars from '../components/Pillars.astro';
import HowWeWork from '../components/HowWeWork.astro';
import ContactForm from '../components/ContactForm.astro';
import PastCircles from '../components/PastCircles.astro';
import VisitedPlacesMap from '../components/VisitedPlacesMap.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout schemaType="event">
  <Header />
  <main>
    <Hero />
    <WhoWeAre />
    <Testimonials />
    <Schedule />
    <HowWeWork />
    <Pillars />
    <VisitedPlacesMap />
    <PastCircles />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
