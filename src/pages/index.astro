---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import Testimonials from '../components/Testimonials.astro';
import Schedule from '../components/Schedule.astro';
import Pillars from '../components/Pillars.astro';
import HowWeWork from '../components/HowWeWork.astro';
import ContactForm from '../components/ContactForm.astro';
import PastCircles from '../components/PastCircles.astro';
import VisitedPlacesMap from '../components/VisitedPlacesMap.astro';
import Footer from '../components/Footer.astro';
import LatestBlogPosts from '../components/LatestBlogPosts.astro';
import { getCirclesState } from '../lib/circles';
import { getCollection } from 'astro:content';

const { nextCircle, upcomingCircles, pastCircles } = await getCirclesState();
const nextUpcomingCircles = upcomingCircles.slice(1, 4);

const allBlogPosts = await getCollection('blog');
const latestBlogPosts = allBlogPosts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

if (!nextCircle) {
  throw new Error('No upcoming circle found in content collection "circles".');
}

const schemaEvent = {
  description: nextCircle.data.description,
  startsAt: nextCircle.data.startsAt,
  endsAt: nextCircle.data.endsAt,
  place: nextCircle.data.place,
  locality: nextCircle.data.locality,
  addressRegion: nextCircle.data.addressRegion,
  addressCountry: nextCircle.data.addressCountry,
  topic: nextCircle.data.topic,
};
---

<BaseLayout schemaType="event" schemaEvent={schemaEvent}>
  <Header />
  <main>
    <Hero upcomingCircle={nextCircle} />
    <WhoWeAre />
    <Testimonials />
    <Schedule nextCircle={nextCircle} nextUpcomingCircles={nextUpcomingCircles} />
    <HowWeWork />
    <Pillars />
    <VisitedPlacesMap />
    <PastCircles circles={pastCircles} />
    <LatestBlogPosts posts={latestBlogPosts} />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
