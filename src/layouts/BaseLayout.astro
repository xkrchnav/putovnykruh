---
import { getImage } from 'astro:assets';
import faviconSrc from '../assets/images/favicon-source.jpg';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Putovný mužský kruh',
  description = 'Putovný mužský kruh - okres Blansko. Bezpečný priestor pre mužov, ktorí hľadajú viac než len povrchné debaty.',
} = Astro.props;

// Generate optimized favicons from the high-res logo
const favicon32 = await getImage({ src: faviconSrc, width: 32, height: 32, format: 'png' });
const favicon192 = await getImage({ src: faviconSrc, width: 192, height: 192, format: 'png' });
const appleTouchIcon = await getImage({ src: faviconSrc, width: 180, height: 180, format: 'png' });

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Putovný mužský kruh" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="sk_SK" />

    <!-- Favicons - generated from high-res logo -->
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="192x192" href={favicon192.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Fonts - preconnect for speed, swap for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap&subset=latin-ext"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <div class="bg-pattern" aria-hidden="true"></div>
    <slot />

    <!-- Google Analytics -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-RX3B3JFBES"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-RX3B3JFBES');
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
