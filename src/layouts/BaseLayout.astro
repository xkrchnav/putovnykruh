---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Putovny muzsky kruh',
  description = 'Putovny muzsky kruh - okres Blansko',
} = Astro.props;
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Putovny muzsky kruh" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="bg-pattern" aria-hidden="true"></div>
    <slot />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-RX3B3JFBES"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-RX3B3JFBES');
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
